# ==========================================================
# 开发环境配置（npm run dev 时生效）
# 修改后需重启 npm run dev
# ==========================================================

# 前端开发服务器端口
VITE_PORT=5173

# 前端请求后端接口时使用的前缀（与后端 context-path 一致）
VITE_API_BASE=/api

# 开发代理：把 /api 开头的请求转发到后端地址（改成你的后端 IP:端口）
VITE_PROXY_TARGET=http://localhost:18080
